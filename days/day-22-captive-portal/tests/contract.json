{
  "schema": 1,
  "lesson": "day-22-captive-portal",
  "title": "Captive Portal",
  "hardware": {
    "board": "m5stack-stopwatch",
    "width": 468,
    "height": 466,
    "offset_x": 6,
    "offset_y": 0,
    "rotation": 0,
    "touch_map": "espt-touch/record"
  },
  "controls": {
    "profile": "c25k",
    "left_button": "BtnA",
    "right_button": "BtnB",
    "left": "previous_or_decrease",
    "right": "next_or_increase",
    "enter": "short_both",
    "back": "hold_both_600ms"
  },
  "state": {
    "screen": {
      "type": "enum",
      "default": "setup",
      "values": [
        "setup",
        "connecting",
        "online",
        "error",
        "forget_confirm"
      ]
    },
    "focus": {
      "type": "enum",
      "default": "retry",
      "values": [
        "retry",
        "forget"
      ]
    },
    "attempts": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 20
    },
    "saved": {
      "type": "bool",
      "default": false
    },
    "rssi": {
      "type": "int",
      "default": -100,
      "min": -100,
      "max": 0
    }
  },
  "scenarios": [
    {
      "name": "primary flow",
      "steps": [
        {
          "action": {
            "type": "credentials_saved"
          },
          "expect": {
            "screen": "connecting",
            "saved": true
          }
        },
        {
          "action": {
            "type": "connected",
            "rssi": -51
          },
          "expect": {
            "screen": "online",
            "rssi": -51
          }
        }
      ]
    },
    {
      "name": "retry",
      "steps": [
        {
          "action": {
            "type": "failed"
          },
          "expect": {
            "screen": "error",
            "attempts": 1
          }
        },
        {
          "action": "enter",
          "expect": {
            "screen": "setup"
          }
        }
      ]
    },
    {
      "name": "forget guard",
      "steps": [
        {
          "action": "right",
          "expect": {
            "focus": "forget"
          }
        },
        {
          "action": "enter",
          "expect": {
            "screen": "forget_confirm"
          }
        },
        {
          "action": "back",
          "expect": {
            "screen": "online"
          }
        }
      ],
      "given": {
        "screen": "online",
        "saved": true,
        "rssi": -55
      }
    }
  ],
  "layout": {
    "safe_radius": 226,
    "focus_inset": 3,
    "controls": [
      {
        "id": "retry",
        "bounds": [
          104,
          110,
          260,
          48
        ]
      },
      {
        "id": "forget",
        "bounds": [
          104,
          178,
          260,
          48
        ]
      }
    ]
  },
  "visual": {
    "kind": "card",
    "eyebrow": "WI-FI",
    "title": "CONNECTED",
    "metric": "\u221251",
    "lines": [
      "studio-net",
      "192.168.1.42"
    ],
    "accent": "#48ef8b",
    "scenario": "primary flow",
    "evidence": "reference"
  }
}
