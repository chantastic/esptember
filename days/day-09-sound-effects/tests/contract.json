{
  "schema": 1,
  "lesson": "day-09-sound-effects",
  "title": "Sound Effects Board",
  "hardware": {
    "board": "m5stack-stopwatch",
    "width": 468,
    "height": 466,
    "offset_x": 6,
    "offset_y": 0,
    "rotation": 0,
    "touch_map": "espt-touch/record"
  },
  "controls": {
    "profile": "localized",
    "left_button": "BtnA",
    "right_button": "BtnB",
    "left": "previous_page",
    "right": "next_page",
    "enter": "touch_pad_press",
    "back": "boot_hold_both_calibration",
    "rationale": "A drum machine needs immediate pad touches; the two pushers are dedicated page controls with visible left and right arrows."
  },
  "state": {
    "page": {
      "type": "enum",
      "default": "page1",
      "values": [
        "page1",
        "page2"
      ]
    },
    "active": {
      "type": "enum",
      "default": "none",
      "values": [
        "jump",
        "coin",
        "death",
        "mario_powerup",
        "shoot",
        "explode",
        "crash",
        "asteroid_powerup",
        "none"
      ]
    },
    "last_trigger": {
      "type": "enum",
      "default": "none",
      "values": [
        "jump",
        "coin",
        "death",
        "mario_powerup",
        "shoot",
        "explode",
        "crash",
        "asteroid_powerup",
        "none"
      ]
    },
    "plays": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 9999
    }
  },
  "scenarios": [
    {
      "name": "primary flow",
      "steps": [
        {
          "action": "pad1_down",
          "expect": {
            "active": "jump",
            "last_trigger": "jump",
            "plays": 1
          }
        },
        {
          "action": "audio_done",
          "expect": {
            "active": "none",
            "last_trigger": "jump",
            "plays": 1
          }
        }
      ]
    },
    {
      "name": "immediate retrigger",
      "given": {
        "active": "jump",
        "last_trigger": "jump",
        "plays": 1
      },
      "steps": [
        {
          "action": "pad2_down",
          "expect": {
            "active": "coin",
            "last_trigger": "coin",
            "plays": 2
          }
        },
        {
          "action": "pad4_down",
          "expect": {
            "active": "mario_powerup",
            "last_trigger": "mario_powerup",
            "plays": 3
          }
        }
      ]
    },
    {
      "name": "pusher paging",
      "steps": [
        {
          "action": "right",
          "expect": {
            "page": "page2"
          }
        },
        {
          "action": "left",
          "expect": {
            "page": "page1"
          }
        },
        {
          "action": "left",
          "expect": {
            "page": "page2"
          }
        }
      ]
    },
    {
      "name": "second page sounds",
      "given": {
        "page": "page2"
      },
      "steps": [
        {
          "action": "pad1_down",
          "expect": {
            "active": "shoot",
            "last_trigger": "shoot",
            "plays": 1
          }
        },
        {
          "action": "pad2_down",
          "expect": {
            "active": "explode",
            "last_trigger": "explode",
            "plays": 2
          }
        }
      ]
    },
    {
      "name": "complete asteroid group",
      "given": {
        "page": "page2"
      },
      "steps": [
        {
          "action": "pad3_down",
          "expect": {
            "page": "page2",
            "active": "crash",
            "last_trigger": "crash",
            "plays": 1
          }
        },
        {
          "action": "pad4_down",
          "expect": {
            "page": "page2",
            "active": "asteroid_powerup",
            "last_trigger": "asteroid_powerup",
            "plays": 2
          }
        }
      ]
    }
  ],
  "layout": {
    "safe_radius": 226,
    "focus_inset": 3,
    "controls": [
      {
        "id": "pad1",
        "bounds": [
          84,
          88,
          132,
          118
        ]
      },
      {
        "id": "pad2",
        "bounds": [
          252,
          88,
          132,
          118
        ]
      },
      {
        "id": "pad3",
        "bounds": [
          84,
          246,
          132,
          118
        ]
      },
      {
        "id": "pad4",
        "bounds": [
          252,
          246,
          132,
          118
        ]
      }
    ]
  },
  "visual": {
    "kind": "pads",
    "eyebrow": "SOUND BOARD",
    "title": "MARIO",
    "metric": "",
    "pads": [
      {
        "label": "JUMP",
        "color": "#ff5b04"
      },
      {
        "label": "COIN",
        "color": "#29c7d8"
      },
      {
        "label": "DEATH",
        "color": "#9b6cff"
      },
      {
        "label": "POWER UP",
        "color": "#55c96f"
      }
    ],
    "page": "1 / 2",
    "accent": "#ff5b04",
    "scenario": "primary flow",
    "evidence": "reference"
  }
}
