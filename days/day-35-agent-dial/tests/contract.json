          "expect": {
            "b_state": "idle"
          }
        },
        {
          "action": {
            "type": "agent",
            "id": "c",
            "stop": true,
            "prompt": true
          },
          "expect": {
            "c_state": "idle",
            "c_stop": true,
            "c_prompt": true
          }
        },
        {
          "action": "right",
          "expect": {
            "screen": "agent",
            "emit": "focus a",
            "focus": "a"
          }
        },
        {
          "action": "right",
          "expect": {
            "focus": "b",
            "emit": "focus b"
          }
        },
        {
          "action": "right",
          "expect": {
            "focus": "c",
            "emit": "focus c"
          }
        },
        {
          "action": "right",
          "expect": {
            "focus": "a",
            "emit": "focus a"
          }
        },
        {
          "action": "left",
          "expect": {
            "focus": "c",
            "emit": "focus c"
          }
        }
      ]
    },
