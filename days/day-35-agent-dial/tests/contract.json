{
  "schema": 1,
  "lesson": "day-35-agent-dial",
  "title": "Agent Dial",
  "hardware": {
    "board": "m5stack-stopwatch",
    "width": 468,
    "height": 466,
    "offset_x": 6,
    "offset_y": 0,
    "rotation": 0,
    "touch_map": "espt-touch/record"
  },
  "controls": {
    "profile": "c25k",
    "left_button": "BtnA",
    "right_button": "BtnB",
    "left": "previous_or_decrease",
    "right": "next_or_increase",
    "enter": "short_both",
    "back": "hold_both_600ms",
    "rationale": "Left/right replace upstream's chevrons and horizontal swipes. Enter is the tile's Voice button (stop-and-send while recording). Back is upstream's BOOT press: dismiss, Cancel task?, abort, or close."
  },
  "state": {
    "a_state": {
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "idle",
        "working"
      ]
    },
    "a_asking": {
      "type": "bool",
      "default": false
    },
    "a_unread": {
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "done",
        "question"
      ]
    },
    "a_stop": {
      "type": "bool",
      "default": false
    },
    "a_prompt": {
      "type": "bool",
      "default": false
    },
    "b_state": {
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "idle",
        "working"
      ]
    },
    "b_asking": {
      "type": "bool",
      "default": false
    },
    "b_unread": {
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "done",
        "question"
      ]
    },
    "b_stop": {
      "type": "bool",
      "default": false
    },
    "b_prompt": {
      "type": "bool",
      "default": false
    },
    "c_state": {
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "idle",
        "working"
      ]
    },
    "c_asking": {
      "type": "bool",
      "default": false
    },
    "c_unread": {
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "done",
        "question"
      ]
    },
    "c_stop": {
      "type": "bool",
      "default": false
    },
    "c_prompt": {
      "type": "bool",
      "default": false
    },
    "connected": {
      "type": "bool",
      "default": false
    },
    "screen": {
      "type": "enum",
      "default": "overview",
      "values": [
        "overview",
        "agent",
        "question",
        "drawer",
        "confirm",
        "voice",
        "settings"
      ]
    },
    "focus": {
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "a",
        "b",
        "c"
      ]
    },
    "voice": {
      "type": "enum",
      "default": "off",
      "values": [
        "off",
        "recording",
        "routing"
      ]
    },
    "voice_target": {
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "a",
        "b",
        "c",
        "routed"
      ]
    },
    "awake": {
      "type": "bool",
      "default": true
    },
    "badge": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 3
    },
    "emit": {
      "type": "string",
      "default": "",
      "max_length": 24
    },
    "sound": {
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "beep"
      ]
    },
    "toast": {
      "type": "string",
      "default": "",
      "max_length": 40
    }
  },
  "scenarios": [
    {
      "name": "the first session is focused without an echo",
      "steps": [
        {
          "action": "welcome",
          "expect": {
            "connected": true
          }
        },
        {
          "action": {
            "type": "agent",
            "id": "a",
            "stop": true,
            "prompt": true
          },
          "expect": {
            "a_state": "idle",
            "a_stop": true,
            "a_prompt": true,
            "focus": "a",
            "screen": "overview",
            "emit": ""
          }
        },
        {
          "action": {
            "type": "agent",
            "id": "b",
            "stop": false,
            "prompt": false
          },
          "expect": {
            "b_state": "idle",
            "focus": "a"
          }
        }
      ]
    },
    {
      "name": "pushers leave the overview for the focused tile and page with wrap",
