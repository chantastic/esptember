    "hunger": {
      "type": "int",
      "default": 5,
      "min": 0,
      "max": 5
    },
    "happiness": {
      "type": "int",
      "default": 5,
      "min": 0,
      "max": 5
    },
    "mess": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 5
    },
    "age_hours": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 9999
    }
  },
  "scenarios": [
    {
      "name": "primary flow",
      "steps": [
        {
          "action": {
            "type": "age",
            "hours": 1
          },
          "expect": {
            "stage": "baby",
            "age_hours": 1
          }
        },
        {
          "action": "enter",
          "expect": {
            "hunger": 5
          }
        }
      ],
      "given": {
        "hunger": 3
      }
    },
    {
      "name": "care menu",
      "steps": [
        {
          "action": "right",
          "expect": {
            "focus": "snack"
          }
        },
        {
          "action": "right",
          "expect": {
            "focus": "play"
          }
        },
        {
          "action": "enter",
          "expect": {
            "happiness": 5
          }
        }
      ],
      "given": {
        "happiness": 3
      }
    },
    {
      "name": "offline aging",
      "steps": [
        {
          "action": {
            "type": "age",
            "hours": 12
          },
          "expect": {
            "hunger": 2,
            "happiness": 3,
            "age_hours": 12
          }
        }
      ],
      "given": {
        "stage": "baby"
      }
    }
  ],
