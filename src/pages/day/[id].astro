---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { youtubeId } from "../../lib/youtube";
import { GITHUB_REPO } from "../../lib/site";

export async function getStaticPaths() {
  const days = await getCollection("days");
  return days.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Firmware source files, rendered on the page (build output excluded).
const allSources = import.meta.glob(
  [
    "../../../days/*/firmware/**/*.{c,h,cpp,hpp}",
    "../../../days/*/firmware/**/CMakeLists.txt",
    "../../../days/*/firmware/sdkconfig.defaults",
    "!**/build/**",
    "!**/managed_components/**",
  ],
  { query: "?raw", import: "default", eager: true },
) as Record<string, string>;

const prefix = `/firmware/`;
const sources = Object.entries(allSources)
  .filter(([path]) => path.includes(`/days/${entry.id}/firmware/`))
  .map(([path, content]) => ({
    path: path.slice(path.indexOf(prefix) + prefix.length),
    content,
  }))
  .sort((a, b) => a.path.localeCompare(b.path));

const githubDir = `${GITHUB_REPO}/tree/main/days/${entry.id}/firmware`;
---

<Layout title={`day ${String(entry.data.day).padStart(2, "0")} · ${entry.data.title}`}>
  <main>
    <nav><a href="/">← ESPtember</a></nav>
    <header>
      <h1>
        <span class="day-num">day {String(entry.data.day).padStart(2, "0")}</span>
        {entry.data.title}
      </h1>
      <p class="meta">
        toolchain: {entry.data.toolchain}
        {
          entry.data.firmware && (
            <>
              {" · "}
              <a href={entry.data.firmware}>download firmware</a>
            </>
          )
        }
        {" · "}
        <a href={githubDir}>source on GitHub</a>
      </p>
    </header>
    {
      entry.data.video && (
        <iframe
          class="video"
          src={`https://www.youtube-nocookie.com/embed/${youtubeId(entry.data.video)}`}
          title={entry.data.title}
          allowfullscreen
        />
      )
    }
    {
      entry.data.firmware && (
        <details class="web-flash">
          <summary>Flash from your browser (experimental)</summary>
          <p>
            This flashes over Web Serial — Chromium-based desktop browsers
            only. It <strong>only works with the Waveshare
            ESP32-S3-Touch-AMOLED-1.8</strong>; other boards may misbehave or
            be damaged. Flashing firmware is inherently risky and
            <strong>overwrites whatever is on the device</strong>. Proceed at
            your own risk — I take no responsibility for damage to your
            device.
          </p>
          <esp-web-install-button
            manifest={`/day/${entry.id}/manifest.json`}
          />
        </details>
      )
    }
    <article>
      <Content />
    </article>

    <script>
      import "esp-web-tools/dist/web/install-button.js";
    </script>
    {
      sources.length > 0 && (
        <section class="sources">
          <h2>Firmware source</h2>
          {sources.map((file) => (
            <details open={file.path.endsWith("main.c")}>
              <summary>
                <code>firmware/{file.path}</code>
              </summary>
              <pre><code>{file.content}</code></pre>
            </details>
          ))}
        </section>
      )
    }
  </main>
  <style>
    .day-num {
      color: var(--accent);
    }
    .meta {
      color: var(--muted);
    }
    .sources details {
      margin-bottom: 0.5rem;
    }
    .sources summary {
      cursor: pointer;
      color: var(--muted);
    }
    .sources summary:hover {
      color: var(--accent);
    }
    .web-flash {
      margin: 1rem 0;
      padding: 0.75rem 1rem;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 6px;
    }
    .web-flash summary {
      cursor: pointer;
      color: var(--muted);
    }
    .web-flash summary:hover {
      color: var(--accent);
    }
    .web-flash p {
      color: var(--muted);
      font-size: 0.9em;
    }
  </style>
</Layout>
