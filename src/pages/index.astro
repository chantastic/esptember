---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
const days = (await getCollection("days")).sort((a,b) => a.data.day-b.data.day);
const latest = days.at(-1)!;
---
<Layout>
  <main id="main-content">
    <section class="hero">
      <div>
        <p class="eyebrow">30 days. One small screen.</p>
        <h1>Big ideas.<br /><span>Small beginnings.</span></h1>
        <p class="lede">A new ESP32 project every day in September. Real code, flashable firmware, and the things we learned getting it to work.</p>
        <div class="hero-actions"><a class="button" href={`/day/${latest.id}/`}>Build day {String(latest.data.day).padStart(2,'0')} →</a><a href="#projects">Explore the projects ↓</a></div>
      </div>
      <div class="screen-study" aria-label="Illustration of an ESPtember greeting on a small display">
        <div class="device"><div class="screen">Hello,<br />ESPtember!<span class="screen-cursor">_</span></div><span class="device-port"></span></div>
        <p class="eyebrow">368 × 448 pixels. Room to begin.</p>
      </div>
    </section>
    <section id="projects" aria-labelledby="projects-heading">
      <div class="section-heading"><div><p class="eyebrow">The daily builds</p><h2 id="projects-heading">Start anywhere.</h2></div><span class="count">{String(days.length).padStart(2,'0')} / 30 published</span></div>
      <p class="section-description">Each project stands on its own. Follow the guide to build it. Read the story to see how we got there.</p>
      <ol class="days">{days.map(entry => <li>
        <a href={`/day/${entry.id}/`} class="day-card">
          <span class="day-num">{String(entry.data.day).padStart(2,'0')}</span>
          <div><h3>{entry.data.title}</h3><p>{entry.data.summary}</p><span class="card-meta">Guide + build story <span>·</span> {entry.data.verification}</span></div>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      </li>)}</ol>
    </section>
    <section class="about-project" aria-label="Getting started">
      <div><p class="eyebrow">The workbench</p><h2>One board.<br />A little further every day.</h2></div>
      <div><p>These projects use the <a href="https://www.waveshare.com/esp32-s3-touch-amoled-1.8.htm">Waveshare ESP32-S3-Touch-AMOLED-1.8 V2</a>: a touch display, an ESP32-S3, and enough room to experiment.</p><p>Use the prebuilt firmware or change the source. Each guide includes commands, expected results, and what has actually been checked.</p><a href="/llms.txt">Working with an agent? Start with the Markdown index ↗</a></div>
    </section>
  </main>
</Layout>
<style>
  .hero { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; padding: 5rem 0 5.5rem; align-items: center; }
  h1 { font-size: clamp(3rem, 6vw, 4.75rem); line-height: 1.02; letter-spacing: -.06em; margin: 1.5rem 0; }
  h1 span { color: var(--accent); }
  .lede { max-width: 34rem; font-size: 1.1rem; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; margin-top: 2rem; }
  .hero-actions > a:last-child { color: var(--muted); font-size: .8rem; }
  .screen-study { text-align: center; }
  .screen-study p { margin-top: 1.5rem; font-size: .6rem; }
  .device { background: #262821; padding: 10px; width: 206px; height: 265px; border-radius: 32px; margin: auto; position: relative; border: 1px solid #55584b; box-shadow: 14px 20px 0 #191b15; transform: rotate(-6deg); }
  .screen { height: 100%; border-radius: 23px; background: #000; color: #ff5b04; display: flex; flex-direction: column; justify-content: center; text-align: center; font: italic 700 25px/1.2 var(--mono); }
  .screen-cursor { font-style: normal; font-size: 18px; margin-top: 8px; }
  .device-port { position: absolute; width: 30px; height: 4px; background: #070806; border-radius: 3px; bottom: -6px; left: calc(50% - 15px); }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; }
  h2 { font-size: 2.2rem; margin: .5rem 0; letter-spacing: -.04em; }
  .count { font: .7rem var(--mono); color: var(--muted); padding-bottom: .7rem; white-space: nowrap; }
  .section-description { color: var(--muted); max-width: 40rem; margin: .5rem 0 2rem; }
  .days { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--border); }
  .day-card { display: grid; grid-template-columns: 3rem 1fr 2rem; align-items: start; gap: 1.5rem; padding: 1.8rem 1rem; border-bottom: 1px solid var(--border); text-decoration: none; color: var(--fg); border-radius: 2px; }
  .day-card:hover { background: var(--card); }
  .day-num { font: .85rem var(--mono); color: var(--accent); padding-top: .25rem; }
  .day-card h3 { margin: 0; font-size: 1.4rem; }
  .day-card p { margin: .5rem 0 .7rem; color: var(--muted); font-size: .95rem; }
  .card-meta { font: .65rem var(--mono); color: var(--muted); }
  .card-meta span { margin: 0 .4rem; }
  .card-arrow { color: var(--accent); font-size: 1.4rem; text-align: right; }
  .about-project { display: grid; grid-template-columns: 1fr 1.3fr; gap: 4rem; margin-top: 5rem; }
  .about-project p { color: var(--muted); margin-top: .5rem; }
  .about-project a { font-size: .9rem; }
  @media(max-width: 760px) { .hero { grid-template-columns: 1fr; padding: 3rem 0; gap: 3rem; } .screen-study { display: none; } .about-project { grid-template-columns: 1fr; gap: 1rem; margin-top: 3rem; } .day-card { grid-template-columns: 2rem 1fr 1rem; gap: .7rem; padding: 1.5rem 0; } .day-card h3 { font-size: 1.2rem; } .count { font-size: .6rem; } .card-meta { line-height: 1.8; } }
</style>
