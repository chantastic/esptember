---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ESPtember` : "ESPtember"}</title>
    <meta
      name="description"
      content="ESPtember — 30 days of individually flashable ESP32-S3 projects."
    />
  </head>
  <body>
    <slot />
    <footer class="conference-footer">
      <section class="conference-cta" aria-labelledby="conference-heading">
        <!-- Official conference wordmark from https://workos.com/init. -->
        <img src="/images/init-logo.svg" alt="init()" width="512" height="115" />
        <p class="conference-meta">
          The conference for builders. By WorkOS.<br />
          October 7 &middot; SFJAZZ Center
        </p>
        <h2 id="conference-heading">Ready to start something?</h2>
        <p>
          Join us at init() 2026. We’re giving away
          <a href="https://shop.m5stack.com/products/m5stack-stopwatch-dev-kit-esp32-s3?variant=48862593515777">M5Stack Stopwatch Dev Kits</a>
          to registrants—because every big thing starts small.
        </p>
        <a class="conference-link" href="https://workos.com/init">
          Register for init() 2026 <span aria-hidden="true">→</span>
        </a>
      </section>
    </footer>
    <style>
      .conference-footer {
        max-width: 48rem;
        margin: 0 auto;
        padding: 0 1rem 3rem;
      }
      .conference-cta {
        padding: clamp(1.25rem, 4vw, 2rem);
        background: var(--card);
        border: 1px solid var(--border);
        border-top: 3px solid var(--accent);
        border-radius: 6px;
      }
      .conference-cta img {
        display: block;
        width: 10rem;
        max-width: 100%;
        height: auto;
      }
      .conference-meta {
        margin: 0.75rem 0 1.5rem;
        color: var(--muted);
        font-size: 0.85rem;
      }
      .conference-cta h2 {
        margin: 0;
        font-size: 1.35rem;
      }
      .conference-link {
        display: inline-block;
        margin-top: 0.5rem;
        padding: 0.65rem 1rem;
        border-radius: 4px;
        background: var(--accent);
        color: var(--bg);
        font-weight: 700;
        text-decoration: none;
      }
      .conference-link:hover {
        text-decoration: underline;
      }
      .conference-link:focus-visible {
        outline: 2px solid var(--fg);
        outline-offset: 4px;
      }
    </style>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #0d1117;
        --fg: #e6edf3;
        --muted: #8b949e;
        --accent: #ff5b04;
        --card: #161b22;
        --border: #30363d;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        line-height: 1.6;
      }
      main {
        max-width: 48rem;
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
      }
      a {
        color: var(--accent);
      }
      h1,
      h2,
      h3 {
        line-height: 1.2;
      }
      pre {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 1rem;
        overflow-x: auto;
      }
      code {
        font-size: 0.9em;
      }
      .video {
        aspect-ratio: 16 / 9;
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 6px;
      }
    </style>
  </body>
</html>
