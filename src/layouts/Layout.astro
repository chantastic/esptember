---
interface Props {
  title?: string;
  description?: string;
  markdown?: string;
}
const { title, description = "Small projects. Real hardware. A new ESP32 build every day in September.", markdown } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ESPtember` : "ESPtember"}</title>
    <meta
      name="description"
      content={description}
    />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Plain Markdown guide" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a href="/" class="wordmark">ESP<span>tember</span><span class="year">2026</span></a>
      <nav aria-label="Main navigation"><a href="/">The projects</a><a href="/llms.txt">For agents</a><a href="https://github.com/chantastic/esptember">GitHub ↗</a></nav>
    </header>
    <slot />
    <footer class="conference-footer">
      <section class="conference-cta" aria-labelledby="conference-heading">
        <!-- Official conference wordmark from https://workos.com/init. -->
        <img src="/images/init-logo.svg" alt="init()" width="512" height="115" />
        <p class="conference-meta">
          The conference for builders. By WorkOS.<br />
          October 7 &middot; SFJAZZ Center
        </p>
        <h2 id="conference-heading">Ready to start something?</h2>
        <p>
          Join us at init() 2026. We’re giving away
          <a href="https://shop.m5stack.com/products/m5stack-stopwatch-dev-kit-esp32-s3?variant=48862593515777">M5Stack Stopwatch Dev Kits</a>
          to registrants—because every big thing starts small.
        </p>
        <a class="conference-link" href="https://workos.com/init">
          Register for init() 2026 <span aria-hidden="true">→</span>
        </a>
      </section>
    </footer>
    <style>
      .conference-footer {
        max-width: 1160px;
        margin: 0 auto;
        padding: 0 1rem 3rem;
      }
      .conference-cta {
        padding: clamp(1.25rem, 4vw, 2rem);
        background: var(--card);
        border: 1px solid var(--border);
        border-top: 3px solid var(--accent);
        border-radius: 6px;
      }
      .conference-cta img {
        display: block;
        width: 10rem;
        max-width: 100%;
        height: auto;
      }
      .conference-meta {
        margin: 0.75rem 0 1.5rem;
        color: var(--muted);
        font-size: 0.85rem;
      }
      .conference-cta h2 {
        margin: 0;
        font-size: 1.35rem;
      }
      .conference-link {
        display: inline-block;
        margin-top: 0.5rem;
        padding: 0.65rem 1rem;
        border-radius: 4px;
        background: var(--accent);
        color: var(--bg);
        font-weight: 700;
        text-decoration: none;
      }
      .conference-link:hover {
        text-decoration: underline;
      }
      .conference-link:focus-visible {
        outline: 2px solid var(--fg);
        outline-offset: 4px;
      }
    </style>
    <style is:global>
      :root { color-scheme: dark; --bg: #11120f; --fg: #efeee7; --muted: #a3a59a; --accent: #ff824d; --card: #1a1c17; --border: #34372f; --mono: ui-monospace, "SF Mono", Menlo, monospace; }
      * { box-sizing: border-box; }
      html { scroll-padding-top: 2rem; }
      body { margin: 0; background: var(--bg); color: var(--fg); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.65; -webkit-font-smoothing: antialiased; }
      main { max-width: 1160px; margin: 0 auto; padding: 0 2rem 5rem; }
      a { color: var(--accent); text-underline-offset: .2em; }
      a:hover { text-decoration-thickness: 2px; }
      a:focus-visible, button:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
      h1,h2,h3 { line-height: 1.15; letter-spacing: -.025em; font-weight: 600; }
      h2 { font-size: 1.7rem; }
      h3 { font-size: 1.2rem; }
      pre { background: #171914; border: 1px solid var(--border); border-radius: 8px; padding: 1.2rem; overflow-x: auto; line-height: 1.65; }
      code { font-family: var(--mono); font-size: .8em; }
      :not(pre) > code { background: var(--card); border-radius: 3px; padding: .1em .25em; overflow-wrap: anywhere; }
      .eyebrow { color: var(--muted); font: .7rem/1.5 var(--mono); text-transform: uppercase; letter-spacing: .12em; }
      .lede { font-size: clamp(1.05rem, 2vw, 1.3rem); color: var(--muted); line-height: 1.55; }
      .button { display: inline-flex; justify-content: center; gap: .5rem; padding: .65rem 1rem; border: 1px solid var(--accent); border-radius: 5px; color: #17120f; background: var(--accent); font: 600 .8rem/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; text-decoration: none; cursor: pointer; }
      .button:hover { background: #ff9e75; text-decoration: none; }
      .prose { font-size: 1.0625rem; }
      .code-block { position: relative; }
      .code-block pre { padding-top: 2.7rem; }
      .copy-code { position: absolute; top: .55rem; right: .6rem; border: 1px solid var(--border); border-radius: 4px; background: var(--card); color: var(--muted); padding: .2rem .55rem; font: .65rem var(--mono); cursor: pointer; }
      .copy-code:hover { color: var(--fg); }
      .copy-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
      .prose h2 { margin: 3rem 0 1.1rem; scroll-margin-top: 2rem; }
      .prose h3 { margin-top: 2rem; scroll-margin-top: 2rem; }
      .prose > :first-child { margin-top: 0; }
      .prose p, .prose li { color: #c5c7bd; }
      .prose strong { color: var(--fg); }
      .prose ul, .prose ol { padding-left: 1.4rem; }
      .prose li { padding-left: .2rem; margin: .6rem 0; }
      .prose li::marker { color: var(--accent); }
      .prose table { display: block; overflow-x: auto; border-collapse: collapse; font-size: .9rem; margin: 1.5rem 0; }
      .prose th { text-align: left; color: var(--fg); }
      .prose th, .prose td { padding: .8rem; border-bottom: 1px solid var(--border); vertical-align: top; min-width: 140px; }
      .prose td { color: #c5c7bd; }
      .prose blockquote { border-left: 2px solid var(--accent); padding-left: 1.2rem; margin-left: 0; }
      .video { aspect-ratio: 16/9; width: 100%; border: 1px solid var(--border); border-radius: 6px; }
      .site-header { max-width: 1160px; margin: auto; padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; border-bottom: 1px solid var(--border); }
      .wordmark { color: var(--fg); font: 700 1rem var(--mono); text-decoration: none; white-space: nowrap; letter-spacing: -.04em; }
      .wordmark > span:first-child { color: var(--accent); }
      .wordmark .year { margin-left: .75rem; color: var(--muted); font-size: .65rem; font-weight: 400; }
      .site-header nav { display: flex; gap: 1.5rem; }
      .site-header nav a { font-size: .75rem; color: var(--muted); text-decoration: none; }
      .site-header nav a:hover { color: var(--fg); }
      .skip-link { position: fixed; top: .5rem; left: 1rem; z-index: 100; transform: translateY(-200%); padding: .5rem 1rem; background: var(--fg); color: var(--bg); }
      .skip-link:focus { transform: none; }
      @media(max-width: 600px) { main { padding: 0 1.25rem 3rem; } .site-header { padding: 1.2rem 1.25rem; } .site-header nav { gap: .8rem; } .site-header nav a { font-size: .65rem; } .wordmark .year { display: none; } .prose { font-size: .95rem; } pre { padding: 1rem; } }
      @media(prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
    </style>
  </body>
</html>
